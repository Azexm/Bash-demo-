+                         reviewed_at = now(), reviewed_by = ${reviewerId}
+                   WHERE id = ${bookingId}`;
+    } else {
+        throw new BookingError("Unknown action", 422);
     }
-    throw new Error("Could not allocate a ticket code");
+    return getClubBooking(bookingId, clubId);
 }
