+
+const errorText = (e) => formatErr(e?.response?.data?.detail) || e?.message || "Something went wrong";
+
+export default function DevPanelPage() {
+    const { user, loading } = useAuth();
+    const nav = useNav();
+    const [tab, setTab] = useState("overview");
+
+    useEffect(() => {
