# Neon connection string (Neon dashboard > Connect > pooled connection)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Secret used to sign login tokens. Generate with: openssl rand -hex 32
AUTH_SECRET=

# Optional: set to "off" to skip creating the demo accounts (see README)
# DEMO_USER=off

# Optional: ticket emails are sent through Resend (https://resend.com).
# Without RESEND_API_KEY nothing is sent, but each attempt is logged in email_logs.
# RESEND_API_KEY=
# EMAIL_FROM="Bash Tickets <tickets@yourdomain.com>"
